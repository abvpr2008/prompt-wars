# ==============================================================================
# CHRONOPULSE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate your sensitive keys and parameters.
# NEVER commit the active '.env' file containing real secrets to version control!
# ==============================================================================

# Server Network & Security Settings
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace_with_a_secure_random_hex_string_32_bytes_or_more
HOST=127.0.0.1
PORT=5000

# Cross-Origin Resource Sharing (CORS) Whitelist
# Comma-separated list of trusted origins (e.g., http://localhost:5000,http://127.0.0.1:5000)
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# File Upload Security Restrictions
# Maximum upload payload size in bytes (Default: 16 MB = 16777216)
MAX_CONTENT_LENGTH=16777216

# Third-Party AI / Vision / Clinical Microservice Credentials (Optional)
# If integrating cloud OCR, LLM summarization, or computer vision APIs:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AWS_TEXTRACT_ACCESS_KEY_ID=
AWS_TEXTRACT_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GOOGLE_APPLICATION_CREDENTIALS=
